+          <h2 class="flex items-center gap-2 text-2xl-semibold leading-none text-ink-gray-8">
+            {{ __('OpenWA Connection') }}
+            <Badge v-if="connected" :theme="active ? 'orange' : 'green'" variant="subtle">
+              {{ active ? __('Active') : __('Connected') }}
+            </Badge>
+          </h2>
+          <p class="mt-2 max-w-2xl text-p-base text-ink-gray-6">
+            {{ __('A self-hosted WhatsApp bridge that runs on your own account. No approved templates and no 24-hour window, and it can see replies you type on your own phone — which is what lets automation stand down when you step in. Unofficial, and it carries account-ban risk.') }}
+          </p>
+        </div>
+
+        <Button
+          v-if="!connected"
+          variant="solid"
+          :label="__('Add connection')"
+          @click="showDialog = true"
+        >
+          <template #prefix><LucidePlus class="h-4 w-4" /></template>
+        </Button>
+      </div>
+
+      <!-- configured state -->
+      <div
+        v-if="connected"
+        class="mt-5 rounded-lg border border-outline-gray-2 bg-surface-white"
+      >
+        <div class="grid grid-cols-3 gap-4 px-4 py-4">
+          <div>
+            <div class="text-xs text-ink-gray-5">{{ __('Server') }}</div>
+            <div class="mt-0.5 truncate text-base text-ink-gray-8">{{ openwa.base_url }}</div>
+          </div>
+          <div>
+            <div class="text-xs text-ink-gray-5">{{ __('Session') }}</div>
+            <div class="mt-0.5 truncate text-base text-ink-gray-8">
+              {{ status.name || openwa.session_id }}
+              <span v-if="status.status" class="text-ink-gray-5">· {{ status.status }}</span>
+            </div>
+          </div>
+          <div>
+            <div class="text-xs text-ink-gray-5">{{ __('Inbound webhook') }}</div>
+            <div class="mt-0.5 text-base"
+                 :class="openwa.has_webhook_secret ? 'text-ink-gray-8' : 'text-orange-600'">
+              {{ openwa.has_webhook_secret ? __('Registered') : __('Not registered') }}
+            </div>
+          </div>
+        </div>
+
+        <div class="flex items-center gap-2 border-t border-outline-gray-2 px-4 py-3">
+          <Button
+            v-if="!active"
+            variant="solid"
+            :label="__('Use for WhatsApp')"
+            @click="useOpenWA"
+          />
+          <Button :label="__('Test connection')" :loading="testing" @click="test" />
+          <Button :label="__('Edit')" @click="showDialog = true" />
+          <Button
+            v-if="!openwa.has_webhook_secret"
+            :label="__('Register webhook')"
+            :loading="hooking"
+            @click="registerHook"
+          />
+          <span
+            v-if="message"
+            class="text-xs"
+            :class="message.ok ? 'text-green-700' : 'text-red-600'"
+          >{{ message.text }}</span>
+        </div>
+      </div>
+
+      <div v-else class="mt-5 rounded-lg border border-dashed border-outline-gray-3 px-4 py-6 text-center">
+        <div class="text-base text-ink-gray-6">{{ __('No OpenWA connection yet.') }}</div>
+        <div class="mt-1 text-xs text-ink-gray-5">
+          {{ __('You will need the server URL, an API key and a logged-in session.') }}
+        </div>
+      </div>
+    </div>
+
+    <OpenWADialog v-model="showDialog" @connected="load" />
+  </div>
 </template>
+
 <script setup>
 import SettingsPage from '@/components/Settings/SettingsPage.vue'
+import OpenWADialog from '@/components/Settings/WhatsApp/OpenWADialog.vue'
+import { Button, Badge, call, toast } from 'frappe-ui'
+import { ref, computed, onMounted } from 'vue'
+import LucidePlus from '~icons/lucide/plus'
+
+const data = ref({})
+const status = ref({})
+const showDialog = ref(false)
+const testing = ref(false)
+const hooking = ref(false)
+const message = ref(null)
+
+const openwa = computed(() => data.value.openwa || {})
+const connected = computed(() => Boolean(openwa.value.has_api_key && openwa.value.session_id))
+const active = computed(() => data.value.active_channel === 'openwa')
+
+async function load() {
+  data.value = await call('baton.api.connections.get_connections')
+  if (connected.value) {
+    try {
+      status.value = await call('baton.api.connections.test_openwa')
+    } catch {
+      status.value = {}
+    }
+  }
+}
+
+async function useOpenWA() {
+  data.value = await call('baton.api.connections.set_active_channel', { channel: 'openwa' })
+  toast.success(__('WhatsApp now goes through OpenWA'))
+}
+
+async function test() {
+  testing.value = true
+  try {
+    const r = await call('baton.api.connections.test_openwa')
+    status.value = r
+    message.value = r.ok
+      ? { ok: true, text: __('Session “{0}” is {1}.', [r.name || '', r.status]) }
+      : { ok: false, text: r.error || __('Could not reach OpenWA.') }
+  } finally {
+    testing.value = false
+  }
+}
+
+async function registerHook() {
+  hooking.value = true
+  try {
+    const s = await call('baton.api.connections.suggest_webhook_url')
+    await call('baton.api.connections.register_openwa_webhook', { public_url: s.url })
+    toast.success(__('Webhook registered'))
+    await load()
+  } catch (e) {
+    message.value = { ok: false, text: e.message || String(e) }
+  } finally {
+    hooking.value = false
+  }
+}
+
+onMounted(load)
 </script>
