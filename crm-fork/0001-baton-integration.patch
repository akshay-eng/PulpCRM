+  </div>
 </template>
+
 <script setup>
 import SettingsPage from '@/components/Settings/SettingsPage.vue'
+import OpenWADialog from '@/components/Settings/WhatsApp/OpenWADialog.vue'
+import { Button, Badge, call, toast } from 'frappe-ui'
+import { ref, computed, onMounted } from 'vue'
+import LucidePlus from '~icons/lucide/plus'
+
+const data = ref({})
+const status = ref({})
+const showDialog = ref(false)
+const testing = ref(false)
+const hooking = ref(false)
+const message = ref(null)
+
+const openwa = computed(() => data.value.openwa || {})
+const connected = computed(() => Boolean(openwa.value.has_api_key && openwa.value.session_id))
+const active = computed(() => data.value.active_channel === 'openwa')
+
+async function load() {
+  data.value = await call('baton.api.connections.get_connections')
+  if (connected.value) {
+    try {
+      status.value = await call('baton.api.connections.test_openwa')
+    } catch {
+      status.value = {}
+    }
+  }
+}
+
+async function useOpenWA() {
+  data.value = await call('baton.api.connections.set_active_channel', { channel: 'openwa' })
+  toast.success(__('WhatsApp now goes through OpenWA'))
+}
+
+async function test() {
+  testing.value = true
+  try {
+    const r = await call('baton.api.connections.test_openwa')
+    status.value = r
+    message.value = r.ok
+      ? { ok: true, text: __('Session “{0}” is {1}.', [r.name || '', r.status]) }
+      : { ok: false, text: r.error || __('Could not reach OpenWA.') }
+  } finally {
+    testing.value = false
+  }
+}
+
+async function registerHook() {
+  hooking.value = true
+  try {
+    const s = await call('baton.api.connections.suggest_webhook_url')
+    await call('baton.api.connections.register_openwa_webhook', { public_url: s.url })
+    toast.success(__('Webhook registered'))
+    await load()
+  } catch (e) {
+    message.value = { ok: false, text: e.message || String(e) }
+  } finally {
+    hooking.value = false
+  }
+}
+
+onMounted(load)
 </script>
